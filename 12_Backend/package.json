{
  "name": "scottstechx-commerce-os-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ScottsTechX Uganda MVP modular monolith backend",
  "type": "module",
  "main": "dist/firebase-entry.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx src/smoke.ts",
    "deploy": "npm run build && firebase deploy --only functions",
    "deploy:all": "npm run build && firebase deploy",
    "emulate": "firebase emulators:start --only functions",
    "setup:secrets": "powershell -ExecutionPolicy Bypass -File scripts/deploy-firebase.ps1",
    "test:e2e": "node tests/e2e.mjs",
    "test:llm": "node tests/llm-integration.mjs",
    "test:geo": "tsx tests/geo-accuracy.mjs",
    "test:ai": "node tests/ai-quality.mjs",
    "test:all": "node tests/e2e.mjs && node tests/ai-quality.mjs && node tests/production-safety.mjs && node tests/google-auth.mjs && node tests/firebase-auth.mjs && node tests/android-contract.mjs && npm run test:geo && npm run test:llm"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@nile-squad/nylonpay-ts": "^2.0.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "fastify": "^5.10.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.6.0",
    "jose": "^6.2.4",
    "pg": "^8.22.0",
    "stripe": "^17.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "vitest": "^2.1.9"
  }
}
