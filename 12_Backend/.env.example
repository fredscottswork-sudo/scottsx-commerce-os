# ── ScottsTechX backend — configuration template ─────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env (it holds secrets).

PORT=3001

# Leave empty to boot the embedded PostgreSQL on 127.0.0.1:5433.
# Set to a managed Postgres URL to skip embedded PG entirely.
DATABASE_URL=

# Where the embedded PostgreSQL cluster lives (relative to 12_Backend/)
PG_DATA_DIR=.pgdata

# HS256 signing secret for our own JWTs (24h expiry)
JWT_SECRET=change-me

# Firebase deep link used for email verification links
APP_DEEP_LINK=https://scottstechx-52bab.firebaseapp.com/__/auth/action

# ── LLM ────────────────────────────────────────────────────────────────────
# Paste a key here and every AI surface (buyer chat, seller copilot, AI search,
# support AI, image search) switches from the built-in catalogue engine to the
# model. With no key the assistant still works — it just answers from the
# catalogue directly instead of writing prose.
#
# The model is always given the live catalogue in its prompt, so it recommends
# real products at real prices rather than inventing them. If the provider is
# down, out of credit or slow, the request falls back to the local answer and
# says so in `provider` — it never fails.
LLM_API_KEY=
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.3-70b-instruct

# Any OpenAI-compatible /chat/completions endpoint works — this is how you use
# a provider other than OpenRouter without touching the code. Examples:
#   https://api.openai.com/v1/chat/completions
#   https://api.groq.com/openai/v1/chat/completions
#   http://localhost:11434/v1/chat/completions      (Ollama)
# Leave blank for OpenRouter. Set AI_MODEL to a model that provider offers.
LLM_BASE_URL=

# Vision model used by image search (same key/endpoint as above).
AI_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# ── Roboflow vision AI ──────────────────────────────────────────────────────
# Photo review: when set, listing photos are run through the Roboflow workflow
# on submit. The decision routes the listing:
#   approved            -> published immediately
#   manual_review       -> normal admin moderation queue
#   rejected            -> blocked (rejection_reasons shown to the seller)
#   needs_better_image  -> blocked, seller asked for a sharper photo
# The same workflow labels photos for image search and AI listing generation,
# and its embedding powers visual (cosine-similarity) search.
# The key lives server-side ONLY — never add it to web/ build env vars.
ROBOFLOW_API_KEY=
# Defaults to the "active-learning" workflow in fredscottswork-gmail-com.
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/fredscottswork-gmail-com/workflows/active-learning
# Call timeout in ms (default 10000). Raise it if the workflow is slow.
ROBOFLOW_TIMEOUT_MS=

# ── NVIDIA NIM vision captions (image search + listing generation) ──────────
# A general vision model that names whatever is in the photo — used alongside
# Roboflow: Roboflow gives the moderation decision + catalogue-trained labels,
# NVIDIA gives the "what IS this" caption when Roboflow's labels are sparse.
# Server-side ONLY — never add to web/ build env vars.
NVIDIA_API_KEY=
# Defaults: https://integrate.api.nvidia.com/v1/chat/completions
#   NVIDIA_MODEL          — chat/assistant model (default nvidia/nemotron-3-ultra-550b-a55b;
#                           text-only — great chat, no image input)
#   NVIDIA_VISION_MODEL   — image caption model (default moonshotai/kimi-k3;
#                           MUST accept image_url)
# If a model is rejected as unknown the server automatically falls back to
# kimi-k2-instruct → llama-3.3-70b-instruct.
NVIDIA_BASE_URL=
NVIDIA_MODEL=
NVIDIA_VISION_MODEL=
# Reasoning prefill for model calls (default true): sends
# chat_template_kwargs.enable_thinking:true like the NVIDIA SDK snippet.
NVIDIA_ENABLE_THINKING=
# Model call timeout in ms (default 120000 — thinking models are slow).
# The key/model are also checked against /v1/models first with a 10s timeout,
# so a bad key or unreachable endpoint fails fast instead of hanging.
NVIDIA_TIMEOUT_MS=

# Public origin of THIS API when it differs from the request host (custom
# domains). Used to build absolute photo URLs for Roboflow.
PUBLIC_API_URL=

# How long to wait for the model before answering from the catalogue instead.
# Default 25000. Reasoning models (GLM, DeepSeek-R1, QwQ) think before they
# answer — give them 60000 or replies get cut off and silently fall back.
# Clamped to 5000–120000.
LLM_TIMEOUT_MS=

# ── Example: NVIDIA NIM running GLM-5.2 (get a key at build.nvidia.com) ─────
#   LLM_API_KEY=nvapi-...
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
#   AI_MODEL=z-ai/glm-5.2
#   LLM_TIMEOUT_MS=60000

# apifreellm LLM (https://apifreellm.com) — set AI_PROVIDER=apifreellm to use it.
# NOTE: the free tier blocks datacenter/cloud IPs (works from residential only).
APIFREELLM_API_KEY=

# Google OAuth client id (Android Web client id) — used to validate Google idTokens
GOOGLE_CLIENT_ID=

# Google API key (optional, for future Google Cloud API calls)
GOOGLE_API_KEY=

# Google Maps Geocoding API key — turns a GPS fix into the REAL place name.
#
# Without it the server falls back to the bundled offline gazetteer, which
# names the nearest settlement it knows. That is instant and free but it is an
# approximation inside a city (a fix in Kawempe resolved to "Kampala", 10.7 km
# away). With a key, Google resolves the area that actually CONTAINS the point,
# so the buyer sees the suburb they are standing in.
#
# Enable "Geocoding API" in Google Cloud, then restrict the key to that API.
# Results are cached per ~11 m, so a moving buyer costs a few calls, not one
# per GPS tick. If the key is missing, over quota or unreachable, the offline
# gazetteer answers instead — the endpoint never fails because of this.
GOOGLE_MAPS_API_KEY=
