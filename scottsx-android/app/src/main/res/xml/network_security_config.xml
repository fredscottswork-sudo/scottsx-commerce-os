<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is blocked globally, but allowed for the local dev API so the app
  can talk to the Fastify backend at http://127.0.0.1:3001 (or the emulator
  host at 10.0.2.2). Production traffic should go over HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
