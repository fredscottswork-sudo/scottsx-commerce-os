<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScottsTechX" parent="android:Theme.Material.NoActionBar">
        <!-- Pre-31 fallback: the launch window itself carries the assembled
             STX monogram dead-centre on the dark stage. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ SplashScreen API: STX visible from the very first tap. -->
        <item name="android:windowSplashScreenBackground">@color/surface_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_stx</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/surface_dark</item>
        <item name="android:windowSplashScreenAnimationDuration">450</item>
    </style>
</resources>
