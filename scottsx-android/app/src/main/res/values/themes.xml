<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app renders a dark-blue/black Compose UI, so the window that shows
         before the first frame must be dark too — a Light parent caused a white
         flash on launch and dark-on-dark status bar icons. -->
    <style name="Theme.ScottsTechX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
